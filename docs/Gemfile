source "https://rubygems.org"

# Same versions GitHub Pages uses (github-pages 232), listed explicitly so the
# site also builds on Ruby >= 3.4 / 4.0, where the github-pages gem cannot install.
gem "jekyll", "~> 3.10.0"
gem "kramdown", "~> 2.4"
gem "kramdown-parser-gfm", "~> 1.1"
gem "rouge", "~> 3.30"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-redirect-from", "~> 0.16"
  gem "jemoji", "~> 0.13"
  gem "jekyll-relative-links", "~> 0.6"
end

# Removed from Ruby's default gems in 3.4+, still needed by Jekyll 3.x
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"

# `jekyll serve` needs it on Ruby >= 3.0
gem "webrick", "~> 1.8"
